# ===== OpenAI（LLM + Embedding，复用智谱 API） =====
OPENAI_API_KEY=your_zhipu_api_key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-3

# ===== 向量库（Chroma 本地持久化） =====
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=books

# ===== 索引参数 =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ===== 检索参数 =====
RETRIEVAL_TOP_K=6
MULTI_QUERY_COUNT=3

# ===== 数据目录 =====
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# ===== 图片 RAG 配置 =====
# 多模态 Embedding（Chinese-CLIP，图文互检）
CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
CLIP_DEVICE=cpu
IMAGE_EMBEDDING_DIM=512

# 图片存储
IMAGE_STORAGE_DIR=data/images
IMAGE_THUMBNAIL_SIZE=224

# 标签提取 LLM（复用智谱 API Key）
IMAGE_TAG_LLM_MODEL=glm-4v
IMAGE_TAG_MAX_COUNT=5

# 图片向量库（独立 collection）
CHROMA_IMAGE_COLLECTION=images

# 图片检索参数
IMAGE_RETRIEVAL_TOP_K=10
IMAGE_SCORE_THRESHOLD=0.2

# ===== PDF 插图提取（MinerU 精准解析 API） =====
# 在 https://mineru.net/apiManage 页面创建 Token
MINERU_TOKEN=your_mineru_token
MINERU_MODEL_VERSION=vlm

# ===== RAGFlow / Dify 外部知识库对接 =====
# RAGFlow 回调本服务时能访问到的地址（填服务器IP:端口，本地调试留空）
EXTERNAL_BASE_URL=http://your-server-ip:8000
# 外部知识库 API Key（在 RAGFlow 侧配置外部知识库时填写同样的值）
DIFY_API_KEY=your_dify_api_key_here
